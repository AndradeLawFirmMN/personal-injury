<?xml version="1.0" encoding="UTF-8"?>
<!-- Andrade Law PLLC service-area KML. Real CID + real, geocoded coordinates.
     POINTS: every coordinate-bearing row of spatial_index.csv (the canonical
     spatial index), each carrying that row's S2 cells + verified Wikidata QIDs
     in ExtendedData.
     POLYGONS: the 17 served municipalities and Ramsey County, exported through
     GDAL/OGR (QGIS) from the Metropolitan Council / MetroGIS boundary layer —
     public domain under Minn. Stat. ch. 13. Source rings, unsimplified,
     reprojected NAD83/UTM15N -> WGS84. Regenerate with
     output/geo/build_service_area_kml.py.
     Canonical home: https://andradelawmn.com/assets/service-area.kml — the URL the
     firm's schema hasMap resolves to (migrated there 2026-08-02). Byte-identical
     mirrors are published at
     https://raw.githubusercontent.com/AndradeLawFirmMN/personal-injury/main/geo/service-area.kml
     and on Hugging Face; a rebuild must be pushed to all three. -->
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Andrade Law PLLC — Service Area</name>
    <description>Andrade Law PLLC, 1327 County Rd D Cir, Saint Paul, MN 55109. Personal injury representation across Ramsey County and the Twin Cities East Metro. Thirteen mapped points — two offices, the Saint Paul service-area core, and ten landmarks drawn from the firm's points-of-interest guides (one, Regency Hospital, lies outside the service boundary in Golden Valley) — plus the boundaries of the 17 served municipalities and Ramsey County. Google Maps CID: 103159562730421070. Point source: spatial_index.csv. Boundary source: Counties and Cities &amp; Townships, Twin Cities Metropolitan Area — Metropolitan Council / MetroGIS (Public domain under the Minnesota Government Data Practices Act (Minn. Stat. ch. 13)).</description>
    <ExtendedData>
      <Data name="firm"><value>Andrade Law PLLC</value></Data>
      <Data name="google_cid"><value>103159562730421070</value></Data>
      <Data name="area_served"><value>Ramsey County, Minnesota</value></Data>
      <Data name="area_served_wikidata_qid"><value>Q491201</value></Data>
      <Data name="geometry_type"><value>points + municipal/county polygons</value></Data>
      <Data name="point_source"><value>https://andradelawmn.com/assets/spatial_index.csv</value></Data>
      <Data name="boundary_source"><value>Counties and Cities &amp; Townships, Twin Cities Metropolitan Area — Metropolitan Council / MetroGIS</value></Data>
      <Data name="boundary_source_url"><value>https://gisdata.mn.gov/dataset/us-mn-state-metc-bdry-metro-counties-and-ctus</value></Data>
      <Data name="boundary_license"><value>Public domain under the Minnesota Government Data Practices Act (Minn. Stat. ch. 13)</value></Data>
      <Data name="boundary_processing"><value>GDAL/OGR (QGIS) export, no simplification, NAD83/UTM15N -&gt; WGS84, 6-decimal precision</value></Data>
      <Data name="logo_url"><value>https://andradelawmn.com/wp-content/uploads/2026/01/Andrade-Law-Logo.png</value></Data>
      <Data name="license"><value>CC-BY-4.0 — attribute to Andrade Law PLLC; photos referenced by URL remain (c) Andrade Law PLLC, all rights reserved</value></Data>
    </ExtendedData>
