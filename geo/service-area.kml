    <Folder>
      <name>Service area — municipalities (17)</name>
      <description>The cities Andrade Law serves, as published on https://andradelawmn.com/resources/methodology/service-area/. Boundaries are the MetroGIS municipal linework, unmodified.</description>
      <Placemark>
        <name>Saint Paul</name>
        <styleUrl>#servedCity</styleUrl>
        <ExtendedData>
          <Data name="role"><value>served_municipality</value></Data>
          <Data name="ctu_name"><value>St. Paul</value></Data>
          <Data name="wikidata_qid"><value>Q28848</value></Data>
          <Data name="boundary_source"><value>Counties and Cities &amp; Townships, Twin Cities Metropolitan Area — Metropolitan Council / MetroGIS</value></Data>
        </ExtendedData>
