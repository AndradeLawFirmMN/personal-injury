<?xml version="1.0" encoding="UTF-8"?>
<!-- Andrade Law PLLC service-area KML. Real CID + real, geocoded coordinates.
     Every placemark mirrors a row of spatial_index.csv (the canonical spatial index)
     and carries that row's S2 cells + verified Wikidata QIDs in ExtendedData.
     POINT DATASET — this file contains NO polygon. The firm's service area is the
     city list published at
     https://andradelawmn.com/resources/methodology/service-area/, not a surveyed
     boundary; do not describe this file as "QGIS-verified" until a boundary export
     clipped to the real Ramsey County / municipal boundary is added.
     Deploy target: /assets/service-area.kml -->
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Andrade Law PLLC — Service Area</name>
    <description>Andrade Law PLLC, 1327 County Rd D Cir, Saint Paul, MN 55109. Personal injury representation across Ramsey County and the Twin Cities East Metro. Six mapped anchors: two offices, the Saint Paul service-area core, and three Saint Paul landmarks. Google Maps CID: 103159562730421070. Source dataset: spatial_index.csv (CC-BY-4.0).</description>
    <ExtendedData>
      <Data name="firm"><value>Andrade Law PLLC</value></Data>
      <Data name="google_cid"><value>103159562730421070</value></Data>
      <Data name="area_served"><value>Ramsey County, Minnesota</value></Data>
      <Data name="area_served_wikidata_qid"><value>Q491201</value></Data>
      <Data name="geometry_type"><value>points only — no polygon in this file</value></Data>
      <Data name="source_dataset"><value>https://raw.githubusercontent.com/AndradeLawFirmMN/personal-injury/main/geo/spatial_index.csv</value></Data>
      <Data name="license"><value>CC-BY-4.0 — attribute to Andrade Law PLLC</value></Data>
    </ExtendedData>

